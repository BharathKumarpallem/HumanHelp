# HumanHelp Environment Variables Template

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional Supabase Integration (PostgreSQL, Auth & Storage)
# Leave blank to run with built-in persistent storage engine
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Model-Independent AI Integration
# Leave blank to use built-in intelligent rule & database matcher
GEMINI_API_KEY=
OPENAI_API_KEY=

# Application URL
VITE_APP_URL=http://localhost:5173
